rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /prestamos/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.libro is string
        && request.resource.data.libro.size() > 0
        && request.resource.data.prestatario is string
        && request.resource.data.prestatario.size() > 0;
      allow delete: if request.auth != null;
    }
  }
}
